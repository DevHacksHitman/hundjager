#!/bin/sh
# Sensitivity gate: refuses to push any commit containing known
# personal-leak fingerprints (purged-history protection, see AGENTS.md).
# Safe-fails on any scan error by treating empty output as a match.
z40=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue
    if [ "$remote_sha" = "$z40" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    matches=$(git log -p "$range" 2>/dev/null | grep -icE "(youpo[r]n|pornh[u]b|xham[s]ter|thumbz[i]lla|xvide[o]s|232[1]17751|sl[u]t|sq[u]irt|Ran [c]ommand:|Used [t]ool:|antigra[v]ity-ide|transcr[i]pt\.jsonl|task-[0-9][0-9]*\.log)")
    if [ "$matches" != "0" ]; then
        echo >&2 "pre-push: BLOCKED — $matches sensitive pattern match(es) in $range ($local_ref -> $remote_ref)"
        echo >&2 "pre-push: inspect with: git log -p '$range' | grep -iE '<pattern>'"
        exit 1
    fi
done
exit 0
